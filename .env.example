VIDU_EMAIL=your-email@example.com
VIDU_API_KEY=your_vidu_api_token
VIDU_BASE_URL=https://api.vidu.com
# Vidu Q4 Preview (Video) — no text2video; uses img2video / reference2video
VIDU_MODEL=viduq4-preview
VIDU_REFERENCE_MODEL=viduq4-preview
VIDU_RESOLUTION=720p
VIDU_POLL_TIMEOUT_SEC=600
VIDU_PROMPT_MAX_CHARS=2000

# Agent 0 live trend ingestion
# Works without keys via Reddit Atom RSS + Google Trends RSS + GDELT.
# Reddit OAuth (optional, preferred when set): https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=CrashOutPOC/1.0 (Agent0 Trend Ingest)
# Optional NewsAPI: https://newsapi.org
NEWS_API_KEY=
# Optional LLM concept writer (heuristic templates used if missing)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
