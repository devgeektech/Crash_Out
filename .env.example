VIDU_EMAIL=your-email@example.com
# Optional process-wide fallback. Prefer saving the key in Settings (encrypted in SQLite).
VIDU_API_KEY=your_vidu_api_token
VIDU_BASE_URL=https://api.vidu.com
# Vidu Q4 Preview (Video) — no text2video; uses img2video / reference2video
VIDU_MODEL=viduq4-preview
VIDU_REFERENCE_MODEL=viduq4-preview
VIDU_RESOLUTION=720p
VIDU_POLL_TIMEOUT_SEC=600
VIDU_PROMPT_MAX_CHARS=2000

# mock = offline placeholders (default; never calls Vidu)
# vidu = live Vidu API (needs credits + VIDU_API_KEY or Settings key)
VIDEO_ENGINE=mock

# ---------------------------------------------------------------------------
# Auth / local app DB
# ---------------------------------------------------------------------------
# Auto-generated on first boot if empty (also written into .env).
AUTH_SECRET_KEY=
# Fernet key for encrypting Vidu API keys at rest (auto-generated if empty).
SECRET_ENCRYPTION_KEY=
# Optional override; default is data/app.db
APP_DB_PATH=

# ---------------------------------------------------------------------------
# Agent 0 — Friction Intersection engine
# ---------------------------------------------------------------------------
# LLM scoring + embeddings (heuristic/Jaccard fallbacks if empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Layer A — mainstream news / trends
NEWSAPI_API_KEY=
GNEWS_API_KEY=
SERPAPI_API_KEY=

# Layer B — youth social
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=CrashOutAgent0/1.0
YOUTUBE_API_KEY=

# Layer C uses public RSS/Reddit JSON (no keys)

# Phase 2 — Postgres + pgvector (optional; file store used if empty)
DATABASE_URL=

# Phase 3 — daily 06:00 America/New_York + Telegram
AGENT0_SCHEDULE_ENABLED=false
AGENT0_SCHEDULE_HOUR=6
AGENT0_SCHEDULE_MINUTE=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Storage & Workflow Orchestration (Milestone 2)
# ---------------------------------------------------------------------------
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=crash-out-production-queue
